@@ -49,17 +48,39 @@ bool writeAllToFile(FileSystem::FileHandle& file, const T& container)
     return true;
 }
 
+// Each array starts at a multiple of its element's alignment, and its offset is
+// returned in `start`: the file is mapped and read in place, and some CPUs
+// (MIPS) fault on misaligned loads, e.g. of the uint64_t actions that follow
+// arrays of uint32_t.
+template<typename T>
+bool writeAllToFile(FileSystem::FileHandle& file, const T& container, size_t& offset, size_t& start)
+{
+    constexpr size_t alignment = alignof(std::remove_cvref_t<decltype(container.span()[0])>);
+    static constexpr std::array<uint8_t, alignment> zeros { };
+    size_t padding = (alignment - offset % alignment) % alignment;
+    if (!writeBytesToFile(file, std::span<const uint8_t>(zeros).first(padding)))
+        return false;
+    offset += padding;
+    start = offset;
+    auto bytes = spanReinterpretCast<const uint8_t>(container.span());
+    if (!writeBytesToFile(file, bytes))
+        return false;
+    offset += bytes.size();
+    return true;
+}
+
 std::optional<SerializedNFA> SerializedNFA::serialize(NFA&& nfa)
 {
     auto [filename, fileHandle] = FileSystem::openTemporaryFile("SerializedNFA"_s);
     if (!fileHandle)
         return std::nullopt;
 
-    bool wroteSuccessfully = writeAllToFile(fileHandle, nfa.nodes)
-        && writeAllToFile(fileHandle, nfa.transitions)
-        && writeAllToFile(fileHandle, nfa.targets)
-        && writeAllToFile(fileHandle, nfa.epsilonTransitionsTargets)
-        && writeAllToFile(fileHandle, nfa.actions);
+    size_t offset = 0, nodesOffset = 0, transitionsOffset = 0, targetsOffset = 0, epsilonTransitionsTargetsOffset = 0, actionsOffset = 0;
+    bool wroteSuccessfully = writeAllToFile(fileHandle, nfa.nodes, offset, nodesOffset)
+        && writeAllToFile(fileHandle, nfa.transitions, offset, transitionsOffset)
+        && writeAllToFile(fileHandle, nfa.targets, offset, targetsOffset)
+        && writeAllToFile(fileHandle, nfa.epsilonTransitionsTargets, offset, epsilonTransitionsTargetsOffset)
+        && writeAllToFile(fileHandle, nfa.actions, offset, actionsOffset);
     if (!wroteSuccessfully) {
         fileHandle = { };
         FileSystem::deleteFile(filename);
@@ -78,17 +99,11 @@ std::optional<SerializedNFA> SerializedNFA::serialize(NFA&& nfa)
         nfa.targets.size(),
         nfa.epsilonTransitionsTargets.size(),
         nfa.actions.size(),
-        0,
-        nfa.nodes.size() * sizeof(nfa.nodes[0]),
-        nfa.nodes.size() * sizeof(nfa.nodes[0])
-            + nfa.transitions.size() * sizeof(nfa.transitions[0]),
-        nfa.nodes.size() * sizeof(nfa.nodes[0])
-            + nfa.transitions.size() * sizeof(nfa.transitions[0])
-            + nfa.targets.size() * sizeof(nfa.targets[0]),
-        nfa.nodes.size() * sizeof(nfa.nodes[0])
-            + nfa.transitions.size() * sizeof(nfa.transitions[0])
-            + nfa.targets.size() * sizeof(nfa.targets[0])
-            + nfa.epsilonTransitionsTargets.size() * sizeof(nfa.epsilonTransitionsTargets[0])
+        nodesOffset,
+        transitionsOffset,
+        targetsOffset,
+        epsilonTransitionsTargetsOffset,
+        actionsOffset
     };
 
     nfa.clear();
