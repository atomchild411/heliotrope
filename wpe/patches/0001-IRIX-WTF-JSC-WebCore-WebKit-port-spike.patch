 #endif
 
 namespace WTF {
@@ -93,6 +102,64 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
     return StackBounds { origin, bound };
 }
 
+#elif OS(IRIX)
+
+// IRIX has no way to ask for a thread's stack (no pthread_getattr_np), so
+// look for the mapping that holds the stack pointer in /proc: a thread's
+// stack is one of its own, above a guard it cannot access; the main
+// thread's is the one the kernel grows on faults (MA_STACK), up to
+// RLIMIT_STACK. Only ever asked from the thread itself
+// (!HAVE(STACK_BOUNDS_FOR_NEW_THREAD)).
+StackBounds StackBounds::currentThreadStackBoundsInternal()
+{
+    volatile char here = 0;
+    uintptr_t sp = reinterpret_cast<uintptr_t>(&here);
+    uintptr_t pageSize = static_cast<uintptr_t>(getpagesize());
+    uintptr_t start = 0, end = 0, previousEnd = 0;
+    bool growsOnFaults = false;
+
+    char path[32];
+    snprintf(path, sizeof(path), "/proc/%d", static_cast<int>(getpid()));
+    int fd = open(path, O_RDONLY);
+    int count = 0;
+    if (fd >= 0 && ioctl(fd, PIOCNMAP, &count) >= 0 && count > 0) {
+        // One more than asked for: the list ends with an empty entry.
+        auto maps = std::make_unique<prmap_t[]>(count + 1);
+        if (ioctl(fd, PIOCMAP, maps.get()) >= 0) {
+            for (int i = 0; i < count; ++i) {
+                uintptr_t low = reinterpret_cast<uintptr_t>(maps[i].pr_vaddr);
+                uintptr_t high = low + maps[i].pr_size;
+                if (sp >= low && sp < high) {
+                    start = low;
+                    end = high;
+                    growsOnFaults = maps[i].pr_mflags & MA_STACK;
+                } else if (high <= sp && high > previousEnd)
+                    previousEnd = high;
+            }
+        }
+    }
+    if (fd >= 0)
+        close(fd);
+
+    if (!end) {
+        // No /proc: a small stack just around here.
+        end = (sp + pageSize) & ~(pageSize - 1);
+        return StackBounds { reinterpret_cast<void*>(end), reinterpret_cast<void*>(end - 64 * KB) };
+    }
+    if (growsOnFaults) {
+        rlimit limit;
+        getrlimit(RLIMIT_STACK, &limit);
+        rlim_t size = limit.rlim_cur;
+        if (size == RLIM_INFINITY || size > end)
+            size = 8 * MB;
+        start = end - size;
+        // Not into the mapping below it, and leave a page for a guard.
+        if (start < previousEnd + pageSize)
+            start = previousEnd + pageSize;
+    }
+    return StackBounds { reinterpret_cast<void*>(end), reinterpret_cast<void*>(start) };
+}
+
 #elif OS(UNIX) || OS(HAIKU)
 
 #if OS(OPENBSD)
diff --git a/Source/WTF/wtf/linux/CurrentProcessMemoryStatus.cpp b/Source/WTF/wtf/linux/CurrentProcessMemoryStatus.cpp
index 9dd80c24..100382f9 100644
--- a/Source/WTF/wtf/linux/CurrentProcessMemoryStatus.cpp
+++ b/Source/WTF/wtf/linux/CurrentProcessMemoryStatus.cpp
@@ -31,8 +31,35 @@
 #include <unistd.h>
 #include <wtf/PageBlock.h>
 
+#if OS(IRIX)
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/procfs.h>
+#endif
+
 namespace WTF {
 
+#if OS(IRIX)
+// No /proc/self/statm: the process image and resident set sizes that ps(1)
+// shows, from /proc/<pid>.
+void currentProcessMemoryStatus(ProcessMemoryStatus& memoryStatus)
+{
+    char path[32];
+    snprintf(path, sizeof(path), "/proc/%d", static_cast<int>(getpid()));
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return;
+    prpsinfo_t info { };
+    int result = ioctl(fd, PIOCPSINFO, &info);
+    close(fd);
+    if (result < 0)
+        return;
+    size_t pageSize = static_cast<size_t>(getpagesize());
+    memoryStatus.size = static_cast<size_t>(info.pr_size) * pageSize;
+    memoryStatus.resident = static_cast<size_t>(info.pr_rssize) * pageSize;
+}
+#else
+
 IGNORE_CLANG_WARNINGS_BEGIN("unsafe-buffer-usage-in-libc-call")
 void currentProcessMemoryStatus(ProcessMemoryStatus& memoryStatus)
 {
@@ -64,5 +91,6 @@ void currentProcessMemoryStatus(ProcessMemoryStatus& memoryStatus)
     memoryStatus.dt = intValue * pageSize;
 }
 IGNORE_CLANG_WARNINGS_END
+#endif // OS(IRIX)
 
 } // namespace WTF
